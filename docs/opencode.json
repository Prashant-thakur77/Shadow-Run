{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vultr": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vultr Serverless Inference",
      "options": {
        "apiKey": "{env:VULTR_INFERENCE_KEY}",
        "baseURL": "https://api.vultrinference.com/v1"
      },
      "models": {
        "qwen3.8-27b": { "name": "Qwen 3.8 27B", "tool_call": true },
        "glm-5.3": { "name": "GLM 5.3", "tool_call": true }
      }
    }
  },
  "model": "vultr/qwen3.8-27b",
  "mcp": {
    "shadowrun": {
      "type": "remote",
      "url": "https://45-76-245-71.sslip.io/mcp",
      "enabled": true,
      "headers": { "Authorization": "Bearer {env:SHADOWRUN_TOKEN}" }
    }
  },
  "tools": {
    "bash": false,
    "write": false,
    "edit": false
  }
}
