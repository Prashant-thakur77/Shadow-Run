# Copy to .env (gitignored). Never put real values in chat or in the repo.

# Vultr account API key: https://my.vultr.com/settings/#settingsapi
# Add this machine's public IP to the key's Access Control list.
VULTR_API_KEY=

# Vultr Serverless Inference (the only LLM provider Shadow Run uses)
VULTR_INFERENCE_BASE=https://api.vultrinference.com/v1
VULTR_INFERENCE_KEY=
SHADOWRUN_MODEL=qwen3.8-27b

# Provisioning defaults
VULTR_REGION=sea
